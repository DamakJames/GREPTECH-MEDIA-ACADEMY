rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    function isInstructor() {
      return isAuthenticated() && (request.auth.token.role == 'instructor' || request.auth.token.role == 'admin');
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // 1. Users Collection
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isAuthenticated() && request.auth.uid == userId;
      allow update: if (isOwner(userId) && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status'])) || isAdmin();
      allow delete: if isAdmin();
    }

    // 2. Admissions Applications
    match /applications/{applicationId} {
      // Anyone can submit an application with required fields
      allow create: if request.resource.data.fullName is string
                    && request.resource.data.email is string
                    && request.resource.data.phone is string
                    && request.resource.data.selectedCourse is string;
      // Anyone can query their application status, admins can read all & manage
      allow read: if true;
      allow update, delete: if isAdmin();
    }

    // 3. Courses (Public Read, Admin Write)
    match /courses/{courseId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Articles / Media Hub (Public Read, Admin Write)
    match /articles/{articleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Facilities & Showcase Projects (Public Read, Admin Write)
    match /facilities/{facilityId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /projects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Public Certificate Verification
    match /certificates/{certificateId} {
      // Anyone can read verification details (limited fields)
      allow read: if true;
      // Only admins can generate or revoke certificates
      allow write: if isAdmin();
    }

    // 7. LMS: Cohorts, Lessons, Assignments, Submissions, Grades
    match /cohorts/{cohortId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if isAuthenticated();
      allow write: if isInstructor();
    }

    match /assignments/{assignmentId} {
      allow read: if isAuthenticated();
      allow write: if isInstructor();
    }

    match /submissions/{submissionId} {
      allow read: if isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow create: if isAuthenticated() && request.resource.data.studentId == request.auth.uid;
      allow update: if isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
    }

    match /grades/{gradeId} {
      allow read: if isInstructor() || (isAuthenticated() && resource.data.studentId == request.auth.uid);
      allow write: if isInstructor();
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

