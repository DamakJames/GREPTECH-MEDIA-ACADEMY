# Greptech Media Academy — Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project credentials from the Firebase Console

VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=greptech-media-academy.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=greptech-media-academy
VITE_FIREBASE_STORAGE_BUCKET=greptech-media-academy.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id_here
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Toggle local emulator suite (true to connect to localhost emulators, false for production Firebase)
VITE_USE_FIREBASE_EMULATOR=false

