rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.role == 'admin';
    }

    // 1. Application Passports: Anyone can upload a photo when applying
    // Must be image format (jpeg/png) and under 2MB
    match /applications/{applicationId}/{fileName} {
      allow read: if isAdmin();
      allow write: if request.resource.size < 2 * 1024 * 1024
                   && (request.resource.contentType.matches('image/jpeg') || request.resource.contentType.matches('image/png'));
    }

    // 2. Student Submissions: Authenticated students can upload files up to 50MB
    match /submissions/{cohortId}/{studentId}/{fileName} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated()
                   && request.auth.uid == studentId
                   && request.resource.size < 50 * 1024 * 1024;
    }

    // 3. Certificates: PDF downloads generated by Admin
    match /certificates/{certificateId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Public Branding & Media
    match /public/{allPaths=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}

